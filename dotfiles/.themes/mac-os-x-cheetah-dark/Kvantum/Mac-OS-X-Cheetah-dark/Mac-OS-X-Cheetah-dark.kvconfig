[%General]
author=Tsu Jan
comment=A translucent light Kvantum theme with rough glass windows
alt_mnemonic=true
animate_states=false
attach_active_tab=false
blurring=true
button_icon_size=16
center_toolbar_handle=true
check_size=16
click_behavior=0
combo_as_lineedit=true
combo_focus_rect=true
combo_menu=true
composite=true
contrast=1.00
dialog_button_layout=0
drag_from_buttons=false
embedded_tabs=true
fill_rubberband=false
group_toolbar_buttons=true
groupbox_top_label=true
hide_combo_checkboxes=false
inline_spin_indicators=true
intensity=1.00
joined_inactive_tabs=true
large_icon_size=32
layout_margin=4
layout_spacing=3
left_tabs=false
menu_blur_radius=2
menu_shadow_depth=7
menubar_mouse_tracking=true
merge_menubar_with_toolbar=false
mirror_doc_tabs=false
no_inactiveness=false
no_window_pattern=false
opaque=kaffeine,kmplayer,subtitlecomposer,kdenlive,vlc,smplayer,smplayer2,avidemux,avidemux2_qt4,avidemux3_qt4,avidemux3_qt5,kamoso,QtCreator,VirtualBox,VirtualBoxVM,trojita,dragon,digikam,lyx
popup_blurring=true
progressbar_thickness=8
reduce_menu_opacity=0
reduce_window_opacity=0
remove_extra_frames=true
respect_DE=true
saturation=1.00
scroll_arrows=true
scroll_min_extent=50
scroll_width=12
scrollable_menu=true
scrollbar_in_view=true
shadowless_popup=false
slider_handle_length=15
slider_handle_width=20
slim_toolbars=true
small_icon_size=16
spin_button_width=16
spread_menuitems=true
spread_progressbar=true
submenu_delay=250
submenu_overlap=0
tickless_slider_handle_size=18
toolbar_icon_size=16
toolbar_interior_spacing=3
toolbar_separator_thickness=2
toolbutton_style=1
tooltip_blur_radius=2
tooltip_delay=-1
tooltip_shadow_depth=6
transient_groove=false
transient_scrollbar=false
translucent_windows=true
tree_branch_line=true
vertical_spin_indicators=false
x11drag=all

[GeneralColors]
window.color=#3D3D3E
window.text.color=white
base.color=#222222
text.color=white
alt.base.color=#393939
button.color=#434343
button.text.color=white
light.color=#9f9f9f
mid.light.color=#6a6a6a
dark.color=#101010
mid.color=#232323
highlight.color=#3b81d5
highlight.text.color=white
inactive.highlight.color=#3b81d5
disabled.text.color=#7f7f7f
tooltip.text.color=white
link.color=#0057AE
link.visited.color=#644A9B
progress.indicator.text.color=white

[Hacks]
transparent_dolphin_view=true
transparent_ktitle_label=true
blur_translucent=true
transparent_menutitle=false
respect_darkness=false
force_size_grip=true
iconless_menu=false
iconless_pushbutton=false
transparent_pcmanfm_sidepane=true
disabled_icon_opacity=50
lxqtmainmenu_iconsize=22
normal_default_pushbutton=false
single_top_toolbar=true
tint_on_mouseover=0
transparent_pcmanfm_view=true
no_selection_tint=true
centered_forms=true
blur_only_active_window=false
kinetic_scrolling=false
middle_click_scroll=false
noninteger_translucency=false
style_vertical_toolbars=false

[PanelButtonCommand]
frame.top=3
frame.bottom=4
frame.left=3
frame.right=3
frame.expanded.top=0
frame.expanded.bottom=2
frame.expanded.left=1
frame.expanded.right=1
text.margin.top=5
text.margin.bottom=5
text.margin.left=8
text.margin.right=8
text.press.color=white
text.toggle.color=white
focusFrame=true
frame.expansion=3font
indicator.size=10
min_height=+0.1font
min_width=0

[PanelButtonTool]
inherits=PanelButtonCommand
min_width=0
frame.expansion=0
text.margin.top=2
text.margin.bottom=2
text.margin.left=2
text.margin.right=2

[DockTitle]
text.bold=true
text.normal.color=white
frame.expansion=0

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
frame.top=5
frame.bottom=5
frame.left=5
frame.right=5
text.margin.top=0
text.margin.bottom=0
text.margin.left=0
text.margin.right=0
min_height=0
frame.expansion=10
indicator.element=combo
indicator.size=11

[IndicatorSpinBox]
inherits=PanelButtonCommand
interior.element=button
frame.element=button
frame.bottom=3

[DropDownButton]
inherits=PanelButtonCommand
frame.expansion=0

[ToolboxTab]
inherits=PanelButtonCommand
text.margin.top=2
text.margin.bottom=2
text.margin.left=3
text.margin.right=3
text.press.color=white
frame.expansion=0

[Tab]
inherits=PanelButtonCommand
focusFrame=true
focusInterior=true
frame.element=button
interior.element=button
frame.top=5
frame.bottom=5
frame.left=5
frame.right=5
text.margin.top=3
text.margin.bottom=3
text.margin.left=3
text.margin.right=3
indicator.size=12
min_width=+0.4font
min_height=0

[TabFrame]
inherits=PanelButtonCommand
frame=true
frame.element=tframe
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
interior=false

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.size=10
indicator.element=arrow

[HeaderSection]
inherits=PanelButtonCommand
interior.element=button
frame.element=button
frame.bottom=3
frame.expansion=0
min_height=0
min_width=0
text.margin.top=2
text.margin.bottom=2
text.margin.left=3
text.margin.right=3

[GroupBox]
interior=false
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.normal.color=#b9b9b9
text.focus.color=white
text.bold=true
frame.expansion=0

[SizeGrip]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=resize-grip
indicator.size=13
frame.expansion=0

[Toolbar]
inherits=PanelButtonCommand
interior=true
interior.element=toolbar
indicator.size=5
frame.left=0
frame.right=0
frame.top=2
frame.bottom=2
frame.element=none
frame.expansion=0

[Scrollbar]
inherits=PanelButtonCommand
indicator.element=arrow
indicator.size=10

[ScrollbarSlider]
inherits=PanelButtonCommand
interior=false
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
frame.expansion=0

[ScrollbarGroove]
inherits=PanelButtonCommand
interior=false
frame=false

[ScrollbarTransientSlider]
frame=true
frame.element=tr
interior=false



[Progressbar]
text.bold=false
frame.left=4
frame.right=4
frame.top=4
frame.bottom=4
frame.expansion=3.5font

[ProgressbarContents]
inherits=PanelButtonCommand
frame=true
frame.element=progress-pattern
frame.left=4
frame.right=4
frame.top=4
frame.bottom=4

[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin=true
text.margin.top=1
text.margin.bottom=1
text.margin.left=2
text.margin.right=2
text.normal.color=white
text.focus.color=wihte
text.press.color=white
text.toggle.color=white
frame.expansion=8
min_height=0
min_width=0

[Menu]
inherits=PanelButtonCommand
text.margin=1
text.margin.top=2
text.margin.bottom=2
text.margin.left=2
text.margin.right=2
frame.expansion=0

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
text.margin.top=1
text.margin.bottom=1
text.margin.left=3
text.margin.right=3
frame.expansion=0
min_height=0
min_width=0

[MenuBar]
inherits=PanelButtonCommand
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
frame.element=menuitem
interior.element=menuitem

[MenuBarItem]
inherits=PanelButtonCommand
text.margin.top=2
text.margin.bottom=2
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin.left=4
text.margin.right=4
frame.expansion=0
min_height=0
min_width=0

[TitleBar]
inherits=PanelButtonCommand
text.margin.top=2
text.margin.bottom=2
text.margin.left=3
text.margin.right=3
text.bold=true
text.italic=true
text.normal.color=white
indicator.size=12
frame.expansion=0

[ComboBox]
inherits=PanelButtonCommand
indicator.element=combo
text.margin.top=3
text.margin.bottom=3
text.margin.left=8
text.margin.right=8
min_height=+0.1font
indicator.size=11
min_width=0

[WindowTranslucent]
interior=false
interior.element=window
interior.x.patternsize=48
interior.y.patternsize=48
frame.expansion=0

[Splitter]
indicator.size=32
frame.expansion=0

[Focus]
frame=true
