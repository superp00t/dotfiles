#!/usr/bin/env bash

WALLPAPER_DIR="$HOME/eiga/mnt/media/Private/Wallpaper"
CURRENT_WALL=$(hyprctl hyprpaper listloaded)

# Get a random wallpaper that is not the current one
WALLPAPER=$(find "$WALLPAPER_DIR" -type f ! -name "$(basename "$CURRENT_WALL")" | shuf --random-source=/dev/urandom -n 1)

echo "$WALLPAPER"

# Apply the selected wallpaper
hyprctl hyprpaper wallpaper ",$WALLPAPER"
