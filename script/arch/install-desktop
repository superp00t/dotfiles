#!/usr/bin/env bash

if command -v flatpak >/dev/null 2>&1; then
    echo "flatpak is installed"
else
    echo "flatpak is NOT installed. installing now" >&2
    sudo pacman -S --needed --noconfirm flatpak
fi

flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

sudo pacman -S --needed --noconfirm \
    btop \
    sshfs \
	zsh \
    fzf \
	git \
	base-devel \
    cmake \
	rsync \
	keyd \
    alacritty \
	fastfetch \
	neovim \
	tree-sitter-cli \
    lua-language-server \
	firefox \
    firefox-ublock-origin \
	keepassxc \
	cliphist \
	jdk-openjdk \
	pavucontrol \
	less \
    hyprlauncher \
    hyprpaper \
    hyprpolkitagent \
    imv \
    mpv \
    gimp \
    signal-desktop \
    thunar \
    gnome-keyring \
    flameshot \
    qutebrowser \
    python-adblock

# keyd must be enabled

sudo cp config/keyd/keyd.conf /etc/keyd/default.conf

sudo systemctl enable --now keyd.service
sudo systemctl restart keyd.service
sudo keyd reload

# use script/update-yay to install yay or update

yay -S --needed --noconfirm \
	minecraft-launcher \
	mmv \
    ashell-git \
    jellyfin-tui \
    waypaper

# flatpaks

flatpak install -y com.usebottles.bottles
